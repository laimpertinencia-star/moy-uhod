{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/schema.json",
  "name": "moy-uhod-assistant",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "vars": {
    "OPENAI_MODEL": "gpt-5.5",
    "ALLOWED_ORIGINS": "https://laimpertinencia-star.github.io,http://localhost:4174,http://127.0.0.1:4174,http://172.20.10.11:4174"
  },
  "ratelimits": [
    {
      "name": "ASSISTANT_RATE_LIMITER",
      "namespace_id": "92741",
      "simple": { "limit": 8, "period": 60 }
    }
  ]
}
